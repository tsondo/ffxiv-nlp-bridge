# Provider: "claude" or "openai" (openai = any OpenAI-compatible API)
NLP_BRIDGE_LLM_PROVIDER=claude

# --- Claude provider ---
# Uses ANTHROPIC_API_KEY env var by default, or set explicitly:
# NLP_BRIDGE_LLM_API_KEY=sk-ant-...
# NLP_BRIDGE_LLM_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI-compatible provider (vLLM, llama.cpp, ollama, etc.) ---
# NLP_BRIDGE_LLM_PROVIDER=openai
# NLP_BRIDGE_LLM_BASE_URL=http://192.168.1.100:8080/v1
# NLP_BRIDGE_LLM_MODEL=meta-llama/Llama-3-8B-Instruct
# NLP_BRIDGE_LLM_API_KEY=unused

# Minion bridge (Lua HTTP server in Windows)
NLP_BRIDGE_MINION_HOST=localhost
NLP_BRIDGE_MINION_PORT=19800
